# ==============================================================================
# Vercel Serverless / Webhook Alerts Configuration
# ==============================================================================
# Discord Webhook URL for sale alerts (Server Settings > Integrations > Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url

# (Optional) Telegram Bot notifications
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_or_channel_id

# Comma-separated list of Steam App IDs to track on scheduled runs
# 620 = Portal 2, 1091500 = Cyberpunk 2077, 292030 = The Witcher 3
TRACKED_APP_IDS=620,1091500,292030

# ==============================================================================
# Discord Bot (bot.py) - Requires 24/7 Hosting (Railway, Render, VPS)
# ==============================================================================
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DATABASE_URL=sqlite:///steam_deals.db
CHECK_INTERVAL_HOURS=1
DEFAULT_CURRENCY=us
DEFAULT_COUNTRY=US
