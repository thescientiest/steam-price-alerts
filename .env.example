# ==============================================================================
# Steam Sale Alert Discord Bot - Configuration
# ==============================================================================

# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Database URL:
# - Default: local SQLite database (zero config, 100% free)
#   DATABASE_URL=sqlite:///steam_deals.db
# - For AWS RDS PostgreSQL:
#   DATABASE_URL=postgresql+psycopg2://<db_user>:<db_password>@<rds_endpoint>:5432/<db_name>
DATABASE_URL=sqlite:///steam_deals.db

# How often the bot checks Steam for price updates and discounts (in hours)
CHECK_INTERVAL_HOURS=1

# Steam Store parameters (country code and currency)
DEFAULT_CURRENCY=us
DEFAULT_COUNTRY=US
